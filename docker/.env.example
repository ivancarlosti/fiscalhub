# Fiscal Hub Environment Configuration
#
# This file is a template: copy it to `.env` and fill in your values before
# starting the container:
#
#     cp .env.example .env
#
# The generated `.env` is gitignored and is never baked into the Docker image.

# ── Web Server ──────────────────────────────────────────────
# Port exposed to the Docker host machine
PORT=8080
# If you are using a reverse proxy (like Nginx), define the domain name here
DOMAIN=fiscalhub.example.com

# ── Meu Danfe API v2 ───────────────────────────────────────
FISCALHUB_API_BASE=https://api.meudanfe.com.br/v2
FISCALHUB_API_KEY=your-api-key-here
FISCALHUB_API_TIMEOUT=60

# ── BrasilAPI ──────────────────────────────────────────────
# BrasilAPI is free and requires no API key.
BRASILAPI_API_BASE=https://brasilapi.com.br/api/cnpj/v1
BRASILAPI_API_TIMEOUT=10

# ── Authentication method (none, account, keycloak) ────────
AUTH_METHOD=none

# ── Account auth settings ───────────────────────────────────
ACCOUNT_LOGIN=
ACCOUNT_PASSWORD=

# ── Google reCAPTCHA v2 (account auth only) ─────────────────
# Leave both keys empty to disable reCAPTCHA entirely (default).
# Keys are created at https://www.google.com/recaptcha/admin (type "v2 checkbox").
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional: override the siteverify endpoint (local testing only)
RECAPTCHA_VERIFY_URL=

# ── Keycloak auth settings ──────────────────────────────────
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=fiscalhub
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
# Where Keycloak sends the browser back after a logout (post logout redirect URI).
KEYCLOAK_REDIRECT_URI=https://fiscalhub.example.com/
# Full URL of /keycloak-callback.php used by the browser login. Leave it empty to
# derive it from the request (https://<host>/keycloak-callback.php) and register
# that URL as a valid redirect URI on the client.
KEYCLOAK_CALLBACK_URI=
KEYCLOAK_EMAIL_ACCOUNT=youremail@example.com
